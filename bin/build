#!/bin/bash
# Build Rust app: install Rust if needed, cargo build (release or debug), copy binary to output.
set -e

# Lifecycle passes layers dir as first arg (buildpack contract); prefer it so launch.toml is in the correct layer.
# See buildpacks-samples/hello-processes and Paketo: use $1 for layers_dir so export merges our launch.toml.
BUILD_DIR="${CNB_BUILD_DIR:-/workspace}"
LAYERS_DIR="${1:-${CNB_LAYERS_DIR:-/layers}}"
OUTPUT_DIR="${CNB_OUTPUT_DIR:-/workspace}"
PLAN_PATH="${CNB_PLAN_PATH:-/dev/null}"

if [[ ! -d "${BUILD_DIR}" ]]; then
  echo "CNB_BUILD_DIR (${BUILD_DIR}) is not a directory" >&2
  exit 1
fi

echo "Octopilot Rust Buildpack"
WORKSPACE_DIR="${BP_RUST_WORKSPACE_DIR:-.}"
MANIFEST_PATH="${BUILD_DIR}/${WORKSPACE_DIR}/Cargo.toml"

# Host-aware target: when BP_RUST_TARGET is unset, use native container arch so we don't
# cross-compile (e.g. avoid x86_64 on aarch64 which causes "cc: error: unrecognized option '-m64'").
if [[ -n "${BP_RUST_TARGET:-}" ]]; then
  TARGET="${BP_RUST_TARGET}"
else
  arch=$(uname -m 2>/dev/null || echo unknown)
  case "${arch}" in
    x86_64|amd64) TARGET="x86_64-unknown-linux-gnu" ;;
    aarch64|arm64) TARGET="aarch64-unknown-linux-gnu" ;;
    armv7l|armv6l) TARGET="armv7-unknown-linux-gnueabihf" ;;
    *) TARGET="x86_64-unknown-linux-gnu" ;;  # fallback for unknown
  esac
fi

PACKAGE="${BP_RUST_PACKAGE:-}"
# Multi-select: BP_RUST_PACKAGES=<pkg>[,<pkg>...] builds a chosen SET of
# workspace members into one image (e.g. a service plus its migration
# binary) — right-sized between single-package and monolith. Takes
# precedence over BP_RUST_PACKAGE when both are set.
PACKAGES="${BP_RUST_PACKAGES:-}"
BINARY_NAME="${BP_RUST_BINARY_NAME:-}"
# Monolith mode: build all workspace binaries into one image (default when workspace and no BP_RUST_PACKAGE/BP_RUST_PACKAGES)
WORKSPACE_MODE="${BP_RUST_WORKSPACE_MODE:-all}"
FEATURES="${BP_RUST_FEATURES:-}"

# Build profile: release (default) or debug (faster compile, larger/slower binary)
case "${BP_RUST_BUILD_PROFILE:-release}" in
  debug|false|0) PROFILE="debug" ;;
  release|true|1) PROFILE="release" ;;
  *) PROFILE="release" ;;
esac

# Toolchain: build+cache only (NOT exported to run image - saves ~1.5GB)
RUST_TOOLCHAIN_LAYER="${LAYERS_DIR}/rust-toolchain"
RUSTUP_HOME="${RUST_TOOLCHAIN_LAYER}/rustup"
CARGO_HOME="${RUST_TOOLCHAIN_LAYER}/cargo"
export RUSTUP_HOME CARGO_HOME
export PATH="${CARGO_HOME}/bin:${PATH}"

# Install Rust into build-only layer (reused on cache)
if [[ ! -x "${CARGO_HOME}/bin/cargo" ]]; then
  echo "Installing Rust..."
  mkdir -p "${RUST_TOOLCHAIN_LAYER}"
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --no-modify-path
  rustup target add "${TARGET}" 2>/dev/null || true
fi

# Mark toolchain as build+cache only (excluded from final image)
cat > "${LAYERS_DIR}/rust-toolchain.toml" << 'TOML'
[types]
build = true
cache = true
launch = false
TOML

# Cached target-dir layer: cargo builds into a CNB cache layer instead of the
# workspace, so incremental compilation survives across builds (the dominant
# cost for large workspaces). Excluded from the run image (build+cache only).
# Combined with `pack --cache-image` / OP_CACHE_IMAGE this cache also survives
# ephemeral CI runners as a registry image.
RUST_TARGET_LAYER="${LAYERS_DIR}/rust-target"
mkdir -p "${RUST_TARGET_LAYER}"
cat > "${LAYERS_DIR}/rust-target.toml" << 'TOML'
[types]
build = true
cache = true
launch = false
TOML
export CARGO_TARGET_DIR="${RUST_TARGET_LAYER}"

# Cache hygiene (cargo-sweep stamp/file ritual): the cached target layer grows
# monotonically and rides the registry cache image on every push/pull, so an
# unbounded cache eventually costs more in transfer than it saves in compile.
# Stamp BEFORE the build, sweep AFTER: everything this build did not touch is
# deleted, keeping the layer exactly as large as the current build needs.
# Disable with BP_RUST_SWEEP=false. Best-effort: any failure skips the sweep.
SWEEP_ENABLED="${BP_RUST_SWEEP:-true}"
SWEEP_DIR="${BUILD_DIR}/${WORKSPACE_DIR}"
if [[ "${SWEEP_ENABLED}" == "true" ]]; then
  if ! command -v cargo-sweep >/dev/null 2>&1; then
    echo "Installing cargo-sweep (cached in toolchain layer)..."
    cargo install cargo-sweep --locked --quiet 2>/dev/null || SWEEP_ENABLED=false
  fi
  if [[ "${SWEEP_ENABLED}" == "true" ]]; then
    cargo sweep --stamp "${SWEEP_DIR}" >/dev/null 2>&1 || SWEEP_ENABLED=false
  fi
fi

# Build args: profile (release or debug), optional target, optional -p, optional --features
EXTRA_ARGS=("--manifest-path" "${MANIFEST_PATH}")
if [[ "$PROFILE" == "release" ]]; then
  EXTRA_ARGS+=(--release)
fi
if [[ -n "$TARGET" ]]; then
  EXTRA_ARGS+=(--target "$TARGET")
fi
if [[ -n "$PACKAGE" ]]; then
  EXTRA_ARGS+=(-p "$PACKAGE")
fi
if [[ -n "$PACKAGES" ]]; then
  IFS=',' read -ra _PKG_LIST <<< "$PACKAGES"
  for _p in "${_PKG_LIST[@]}"; do
    EXTRA_ARGS+=(-p "$_p")
  done
fi
if [[ -n "$FEATURES" ]]; then
  EXTRA_ARGS+=(--features "$FEATURES")
fi
# armv7: jemalloc not supported; disable default features for that target
if [[ "$TARGET" == "armv7-unknown-linux-musleabihf" ]]; then
  EXTRA_ARGS+=(--no-default-features)
fi

# Monolith: build all workspace binaries (no -p). Single: build one package.
# Multi (BP_RUST_PACKAGES): build the listed set.
MONOLITH=false
if [[ -z "$PACKAGE" && -z "$PACKAGES" && "$WORKSPACE_MODE" == "all" ]]; then
  MONOLITH=true
fi

# Build from app root so relative paths in Cargo.toml resolve
cd "${BUILD_DIR}"

# Collect binaries: monolith = all executables, single = one
BINARIES=()
while IFS= read -r line; do
  if [[ "$line" == *'"reason":"compiler-artifact"'* && "$line" == *'"executable":'* ]]; then
    exe=$(echo "$line" | sed -n 's/.*"executable":"\([^"]*\)".*/\1/p')
    if [[ -n "$exe" && -f "$exe" ]]; then
      if [[ "$MONOLITH" == true ]]; then
        BINARIES+=("$exe")
      elif [[ -n "$PACKAGES" ]]; then
        for _p in "${_PKG_LIST[@]}"; do
          if [[ "$line" == *"\"${_p}\""* ]]; then
            BINARIES+=("$exe")
            break
          fi
        done
      elif [[ -n "$PACKAGE" ]]; then
        if [[ "$line" == *"\"${PACKAGE}\""* ]]; then
          BINARIES=("$exe")
          break
        fi
      else
        BINARIES=("$exe")
        break
      fi
    fi
  fi
done < <(cargo build "${EXTRA_ARGS[@]}" --message-format=json 2>/dev/null || true)

# Fallback: locate binary(ies) in profile dir (cargo writes into the cached
# target layer via CARGO_TARGET_DIR)
MANIFEST_DIR="$(dirname "${MANIFEST_PATH}")"
TARGET_DIR="${CARGO_TARGET_DIR}"
PROFILE_DIR="${TARGET_DIR}/${TARGET}/${PROFILE}"
if [[ ! -d "${PROFILE_DIR}" ]]; then
  PROFILE_DIR="${TARGET_DIR}/${PROFILE}"
fi

if [[ ${#BINARIES[@]} -eq 0 ]]; then
  if [[ "$MONOLITH" == true ]]; then
    # Find all executables (exclude .so, .rlib)
    while IFS= read -r exe; do
      [[ -n "$exe" && -f "$exe" ]] && BINARIES+=("$exe")
    done < <(find "${PROFILE_DIR}" -maxdepth 1 -type f -executable ! -name "*.so" ! -name "*.rlib" 2>/dev/null)
  else
    if [[ -n "$BINARY_NAME" ]]; then
      BINARIES=("${PROFILE_DIR}/${BINARY_NAME}")
    elif [[ -n "$PACKAGE" ]]; then
      try_name=$(echo "$PACKAGE" | tr '-' '_')
      found=$(find "${PROFILE_DIR}" -maxdepth 1 -type f -executable \( -name "${try_name}" -o -name "${PACKAGE}" \) 2>/dev/null | head -1)
      [[ -n "$found" ]] && BINARIES=("$found")
    fi
    if [[ ${#BINARIES[@]} -eq 0 ]]; then
      found=$(find "${PROFILE_DIR}" -maxdepth 1 -type f -executable ! -name "*.so" ! -name "*.rlib" 2>/dev/null | head -1)
      [[ -n "$found" ]] && BINARIES=("$found")
    fi
  fi
fi

if [[ ${#BINARIES[@]} -eq 0 ]]; then
  echo "No binary found. Check Cargo.toml [package] name and [[bin]] if used." >&2
  exit 1
fi

# Copy all binaries to output and build launch.toml (at root of buildpack layers dir)
mkdir -p "${OUTPUT_DIR}/bin"

# #region agent log (debug: verify launch.toml path and content for default process)
echo "[rust buildpack] LAYERS_DIR=${LAYERS_DIR} OUTPUT_DIR=${OUTPUT_DIR}" >&2
# #endregion

# Process model: EVERY binary gets a process named after itself, so
# deployments can address /cnb/process/<binary-name> deterministically in
# single, multi (BP_RUST_PACKAGES) and monolith modes. Additionally the
# FIRST binary is aliased as "web" with default = true, preserving the
# `docker run <image>` / default-process behavior. (Previously the first
# binary was ONLY exposed as "web", so charts addressing it by name got
# StartError: /cnb/process/<name> did not exist.)
first=true
for BINARY in "${BINARIES[@]}"; do
  [[ -z "$BINARY" || ! -f "$BINARY" ]] && continue
  BIN_NAME=$(basename "$BINARY")
  cp "$BINARY" "${OUTPUT_DIR}/bin/${BIN_NAME}"
  chmod +x "${OUTPUT_DIR}/bin/${BIN_NAME}"
  proc_type="${BIN_NAME%.*}"
  if [[ -s "${LAYERS_DIR}/launch.toml" ]]; then
    echo "" >> "${LAYERS_DIR}/launch.toml"
  fi
  # Lifecycle 0.21.x expects process command as a string, not array (toml: incompatible types []any vs string).
  cat >> "${LAYERS_DIR}/launch.toml" << LAUNCH
[[processes]]
type = "${proc_type}"
command = "bin/${BIN_NAME}"
LAUNCH
  if [[ "$first" == true ]]; then
    first=false
    cat >> "${LAYERS_DIR}/launch.toml" << LAUNCH

[[processes]]
type = "web"
command = "bin/${BIN_NAME}"
default = true
LAUNCH
  fi
done

# #region agent log (debug: verify launch.toml content)
[[ -f "${LAYERS_DIR}/launch.toml" ]] && echo "[rust buildpack] launch.toml content:" >&2 && cat "${LAYERS_DIR}/launch.toml" >&2
# #endregion

# Write manifest for per-package image tooling (one binary per line)
for b in "${BINARIES[@]}"; do basename "$b"; done > "${OUTPUT_DIR}/.rust-binaries" 2>/dev/null || true

# Cache hygiene, part 2: drop every cached artifact this build did not touch
# (see the --stamp above) so the exported cache image stays right-sized.
if [[ "${SWEEP_ENABLED}" == "true" ]]; then
  echo "Sweeping unused artifacts from cached target layer..."
  cargo sweep --file "${SWEEP_DIR}" 2>/dev/null || true
fi

# Prune the exported app dir: a compiled Rust service does not need its
# source tree (or .git, CI config, encrypted secrets files...) shipped in the
# run image. Keep ONLY bin/ + .rust-binaries + any BP_RUST_KEEP paths
# (comma-separated, relative to the app dir) for services that load runtime
# assets from the source tree (e.g. OpenAPI specs, static sites resolved via
# a compiled-in CARGO_MANIFEST_DIR path).
KEEP_LIST="${BP_RUST_KEEP:-}"
KEEP_STAGE="$(mktemp -d)"
# mktemp -d creates mode 700; tar's "." entry would stamp that onto the app
# dir on restore, making /workspace un-enterable for the run-image user
# (build uid != run uid) -> "failed to launch: chdir /workspace: permission
# denied". Normalize before archiving.
chmod 755 "${KEEP_STAGE}"
mv "${OUTPUT_DIR}/bin" "${KEEP_STAGE}/bin"
[[ -f "${OUTPUT_DIR}/.rust-binaries" ]] && mv "${OUTPUT_DIR}/.rust-binaries" "${KEEP_STAGE}/.rust-binaries"
if [[ -n "${KEEP_LIST}" ]]; then
  IFS=',' read -ra _KEEP_PATHS <<< "${KEEP_LIST}"
  for _kp in "${_KEEP_PATHS[@]}"; do
    _kp="${_kp#/}"                       # forbid absolute escapes
    if [[ -e "${BUILD_DIR}/${_kp}" ]]; then
      mkdir -p "${KEEP_STAGE}/$(dirname "${_kp}")"
      mv "${BUILD_DIR}/${_kp}" "${KEEP_STAGE}/${_kp}"
      echo "Keeping ${_kp} in run image (BP_RUST_KEEP)"
    else
      echo "WARNING: BP_RUST_KEEP path not found: ${_kp}" >&2
    fi
  done
fi
# Delete everything else (incl. dotfiles); || true so odd mounts don't fail the build
find "${BUILD_DIR}" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
# Restore the kept set; belt-and-braces: re-assert traversable app dir so the
# run-image user can always chdir into it at launch.
(cd "${KEEP_STAGE}" && tar cf - .) | (cd "${BUILD_DIR}" && tar xf -)
chmod 755 "${BUILD_DIR}"
rm -rf "${KEEP_STAGE}"
echo "Pruned app dir: run image ships bin/ ${KEEP_LIST:+plus BP_RUST_KEEP paths }only"

echo "Rust build complete (${PROFILE}): ${#BINARIES[@]} binary(ies) -> bin/"
